# Admin account for /dash (server-side only, never exposed to the browser)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Database (libSQL). Defaults to a local SQLite file at data/iordanatrans.db.
# On serverless hosting (e.g. Vercel) use a remote libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
